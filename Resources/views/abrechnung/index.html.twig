{% extends 'base.html.twig' %}
{% import '@Abrechnung/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}
{% import 'macros/datatables.html.twig' as tables %}

{% set state = query.state %}
{% set bulk_form = 'abrechnung-bulk' %}
{% set rate_shown = can_view_rate and not totals.rate_hidden and totals.count > 0 %}
{# immediate actions in the "…" menus: kit.js posts ids[] + _token, JSON {message, undo} -> reload + undo toast #}
{% set mark_url = path('abrechnung_mark', {action: 'mark'}) %}
{% set unmark_url = path('abrechnung_mark', {action: 'unmark'}) %}
{% set mark_token = csrf_token(csrf_token_id) %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Abrechnung/_kit/assets.html.twig' with {kpu_part: 'css'} %}
{% endblock %}

{% block page_intro %}
    {% set customer_names = query.customers|map(c => c.name)|join(', ') %}
    {% set user_names = query.users|map(u => u.displayName)|join(', ') %}
    {{ kit.context_line([
        ('abrechnung.state_' ~ state)|trans,
        customer_names is not empty ? customer_names : 'abrechnung.all_customers'|trans,
        user_names is not empty ? user_names : 'abrechnung.all_users'|trans,
        query.searchTerm is not null ? 'abrechnung.search_context'|trans({'%term%': query.searchTerm.originalSearch}) : null,
    ]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    <div class="d-flex flex-wrap align-items-center gap-2">
        {{ kit.period_nav(['month', 'year'], nav.unit, nav.label, nav.prev, nav.next, nav.today, nav.units) }}
        {{ tables.actions(page_setup.dataTable) }}
    </div>
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% set tiles = [{
        label: ('abrechnung.kpi.duration_' ~ state)|trans,
        value: totals.duration|duration,
        hint: totals.count > 0 ? 'abrechnung.kpi.duration_hint'|trans({'%count%': totals.count}) : null,
        highlight: not rate_shown,
    }] %}
    {% if rate_shown %}
        {% set amounts = [] %}
        {% for currency, amount in totals.amounts %}
            {% set amounts = amounts|merge([amount|money(currency)]) %}
        {% endfor %}
        {% set tiles = tiles|merge([{
            label: ('abrechnung.kpi.amount_' ~ state)|trans,
            value: amounts|join(' · '),
            highlight: true,
        }]) %}
    {% endif %}
    {% set tiles = tiles|merge([
        {label: 'abrechnung.kpi.entries'|trans, value: totals.count|amount},
        {label: 'abrechnung.kpi.customers'|trans, value: totals.customers|amount},
    ]) %}

    {{ kit.kpi_bar(tiles) }}

    {% if groups is empty %}
        {% if query.countFilter() > 0 %}
            {{ kit.empty_state(('abrechnung.empty_' ~ state)|trans, reset_url, 'abrechnung.reset_filter'|trans) }}
        {% else %}
            {{ kit.empty_state(('abrechnung.empty_' ~ state)|trans, billed_url, 'abrechnung.show_billed'|trans) }}
        {% endif %}
    {% else %}
        {% set show_status = state != 'open' %}
        {% for cid, group in groups %}
            {% set customer = group.customer %}
            {% set currency = group.currency %}
            {% set show_group_amount = can_view_rate and not group.rate_hidden %}

            {% set customer_actions = {} %}
            {% if group.markable_ids is not empty %}
                {% set customer_actions = customer_actions|merge({'success': {url: '#', title: 'abrechnung.mark', translation_domain: 'messages', attr: {'data-kpu-post': mark_url, 'data-kpu-token': mark_token, 'data-kpu-ids': group.markable_ids|join(',')}}}) %}
            {% endif %}
            {% if group.unmarkable_ids is not empty %}
                {% set customer_actions = customer_actions|merge({'repeat': {url: '#', title: 'abrechnung.unmark', translation_domain: 'messages', attr: {'data-kpu-post': unmark_url, 'data-kpu-token': mark_token, 'data-kpu-ids': group.unmarkable_ids|join(',')}}}) %}
            {% endif %}
            {% if query.customers|length != 1 %}
                {% set customer_actions = customer_actions|merge({'filter': {url: path('abrechnung_index', filter_params|merge({customers: [customer.id], performSearch: 1})), title: 'abrechnung.only_customer', translation_domain: 'messages'}}) %}
            {% endif %}

            {# group keys for the kit selection: customer "c<id>", project "c<id>-p<id>" (nested) #}
            {% set customer_group = 'c' ~ customer.id %}
            {% set select_all = group.selectable_ids is not empty ? kit.bulk_select_group(bulk_form, customer_group, 'abrechnung.select_group'|trans({'%name%': customer.name})) : '' %}

            {# 390 px: with the status column the description is hidden (select, date, duration, status, …) #}
            {% set columns = {
                'select': {class: 'alwaysVisible multiCheckbox w-min', orderBy: false, title: false, html_after: select_all},
                'date': {class: 'alwaysVisible w-min', orderBy: false, title: 'abrechnung.date'},
                'description': {class: show_status ? 'd-none d-sm-table-cell' : 'alwaysVisible', orderBy: false, title: 'abrechnung.description'},
                'activity': {class: 'd-none d-md-table-cell', orderBy: false, title: 'abrechnung.activity'},
                'user': {class: 'd-none d-md-table-cell', orderBy: false, title: 'abrechnung.user'},
                'duration': {class: 'alwaysVisible text-end w-min', orderBy: false, title: 'abrechnung.duration'},
            } %}
            {% if can_view_rate %}
                {% set columns = columns|merge({'rate': {class: 'd-none d-sm-table-cell text-end w-min', orderBy: false, title: 'abrechnung.amount'}}) %}
            {% endif %}
            {% if show_status %}
                {% set columns = columns|merge({'status': {class: 'w-min', orderBy: false, title: 'abrechnung.state'}}) %}
            {% endif %}
            {% set columns = columns|merge({'actions': {class: 'actions alwaysVisible', orderBy: false}}) %}

            <div class="card mb-3 abrechnung-customer" data-customer="{{ customer.id }}">
                {{ kit.group_header(
                    customer.name,
                    customer.color|colorize(customer.name),
                    show_group_amount ? [group.duration|duration, group.amount|money(currency)] : [group.duration|duration],
                    customer_actions
                ) }}
                {{ tables.datatable_header('abrechnung', columns, null, {boxClass: 'kpu-table-wrap', columnConfig: false, sticky: false, reload: 'kimai.timesheetUpdate kimai.timesheetDelete'}) }}
                    {% for pid, proj in group.projects %}
                        {% set project = proj.project %}
                        {% set project_group = customer_group ~ '-p' ~ project.id %}
                        {% set project_actions = {} %}
                        {% if proj.markable_ids is not empty %}
                            {% set project_actions = project_actions|merge({'success': {url: '#', title: 'abrechnung.mark', translation_domain: 'messages', attr: {'data-kpu-post': mark_url, 'data-kpu-token': mark_token, 'data-kpu-ids': proj.markable_ids|join(',')}}}) %}
                        {% endif %}
                        {% if proj.unmarkable_ids is not empty %}
                            {% set project_actions = project_actions|merge({'repeat': {url: '#', title: 'abrechnung.unmark', translation_domain: 'messages', attr: {'data-kpu-post': unmark_url, 'data-kpu-token': mark_token, 'data-kpu-ids': proj.unmarkable_ids|join(',')}}}) %}
                        {% endif %}
                        {{ kit.group_header(
                            project.name,
                            project.color|colorize(project.name),
                            (can_view_rate and not proj.rate_hidden) ? [proj.duration|duration, proj.amount|money(currency)] : [proj.duration|duration],
                            project_actions,
                            {as_row: true, colspan: columns|length, level: 2, select: proj.selectable_ids is not empty ? {form: bulk_form, group: project_group, label: 'abrechnung.select_group'|trans({'%name%': project.name})} : null}
                        ) }}
                        {% for item in proj.items %}
                            {% set row = rows[item.id] %}
                            {% set row_actions = {} %}
                            {% if row.can_mark %}
                                {% set row_actions = row_actions|merge({'success': {url: '#', title: 'abrechnung.mark', translation_domain: 'messages', attr: {'data-kpu-post': mark_url, 'data-kpu-token': mark_token, 'data-kpu-ids': item.id}}}) %}
                            {% endif %}
                            {% if row.can_unmark %}
                                {% set row_actions = row_actions|merge({'repeat': {url: '#', title: 'abrechnung.unmark', translation_domain: 'messages', attr: {'data-kpu-post': unmark_url, 'data-kpu-token': mark_token, 'data-kpu-ids': item.id}}}) %}
                            {% endif %}
                            {% if row.can_edit %}
                                {% set row_actions = row_actions|merge({'edit': {url: path(is_granted('view_other_timesheet') ? 'admin_timesheet_edit' : 'timesheet_edit', {id: item.id}), class: 'modal-ajax-form', title: 'edit', translation_domain: 'messages'}}) %}
                            {% endif %}
                            <tr class="abrechnung-row" data-id="{{ item.id }}">
                                <td class="{{ datatable_column_class('abrechnung', 'select') }}">
                                    {%- if row.can_mark or row.can_unmark %}{{ kit.bulk_checkbox(bulk_form, item.id, null, [customer_group, project_group]) }}{% endif -%}
                                </td>
                                <td class="{{ datatable_column_class('abrechnung', 'date') }}">{{ item.begin|date_short }}</td>
                                <td class="{{ datatable_column_class('abrechnung', 'description') }}">
                                    {%- if item.description is not empty %}{{ item.description }}{% else %}<span class="text-body-secondary">{{ item.activity.name }}</span>{% endif -%}
                                </td>
                                <td class="{{ datatable_column_class('abrechnung', 'activity') }}">{{ item.activity.name }}</td>
                                <td class="{{ datatable_column_class('abrechnung', 'user') }}">{{ item.user.displayName }}</td>
                                <td class="{{ datatable_column_class('abrechnung', 'duration') }}">{{ item.duration|duration }}</td>
                                {% if can_view_rate %}
                                    <td class="{{ datatable_column_class('abrechnung', 'rate') }}">{% if row.rate_visible %}{{ item.rate|money(currency) }}{% else %}&ndash;{% endif %}</td>
                                {% endif %}
                                {% if show_status %}
                                    <td class="{{ datatable_column_class('abrechnung', 'status') }}">{{ kit.status_badge(item.exported ? 'billed' : 'open') }}</td>
                                {% endif %}
                                <td class="{{ datatable_column_class('abrechnung', 'actions') }}">{{ widgets.table_actions(row_actions) }}</td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                {{ tables.data_table_footer(null, null, null) }}
            </div>
        {% endfor %}

        {% set bulk_actions = [] %}
        {% if markable_ids is not empty %}
            {% set bulk_actions = bulk_actions|merge([{label: 'abrechnung.mark'|trans, url: path('abrechnung_mark', filter_params|merge({action: 'mark'})), token: csrf_token(csrf_token_id), icon: 'success', ajax: true}]) %}
        {% endif %}
        {% if unmarkable_ids is not empty %}
            {% set bulk_actions = bulk_actions|merge([{label: 'abrechnung.unmark'|trans, url: path('abrechnung_mark', filter_params|merge({action: 'unmark'})), token: csrf_token(csrf_token_id), icon: 'repeat', class: markable_ids is empty ? 'btn-primary' : '', ajax: true}]) %}
        {% endif %}
        {% if bulk_actions is not empty %}
            {{ kit.bulk_bar(bulk_form, bulk_actions) }}
        {% endif %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Abrechnung/_kit/assets.html.twig' with {kpu_part: 'js'} %}
{% endblock %}
