{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_content %}
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" action="{{ path('abrechnung_index') }}" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label" for="abrechnung-month">{{ 'abrechnung.month'|trans }}</label>
                    <select name="month" id="abrechnung-month" class="form-select form-select-sm">
                        <option value="">{{ 'abrechnung.all'|trans }}</option>
                        {% for m, monthName in month_names() %}
                            <option value="{{ m + 1 }}"{% if filter_month == m + 1 %} selected{% endif %}>{{ monthName }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label" for="abrechnung-year">{{ 'abrechnung.year'|trans }}</label>
                    <select name="year" id="abrechnung-year" class="form-select form-select-sm">
                        <option value="">{{ 'abrechnung.all'|trans }}</option>
                        {% for y in years %}
                            <option value="{{ y }}"{% if filter_year == y %} selected{% endif %}>{{ y }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label" for="abrechnung-customer">{{ 'abrechnung.customer'|trans }}</label>
                    <select name="customer" id="abrechnung-customer" class="form-select form-select-sm">
                        <option value="">{{ 'abrechnung.all'|trans }}</option>
                        {% for c in customers %}
                            <option value="{{ c.id }}"{% if filter_customer == c.id %} selected{% endif %}>{{ c.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label" for="abrechnung-user">{{ 'abrechnung.user'|trans }}</label>
                    <select name="user" id="abrechnung-user" class="form-select form-select-sm">
                        <option value="">{{ 'abrechnung.all'|trans }}</option>
                        {% for u in users %}
                            <option value="{{ u.id }}"{% if filter_user == u.id %} selected{% endif %}>{{ u.displayName }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-primary">{{ 'abrechnung.filter'|trans }}</button>
                </div>
            </form>
        </div>
    </div>

    {% if groups|length > 0 %}
    <div class="mb-3">
        <button type="button" class="btn btn-success abrechnung-bulk-toggle" data-ids="{{ all_ids|json_encode }}">
            {{ 'abrechnung.mark_all_visible'|trans }}
        </button>
    </div>
    {% endif %}

    {% for cid, group in groups %}
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                {{ widgets.label_dot(group.customer.name, group.customer.color) }}
                <span class="text-muted ms-2">{{ group.totalDuration|duration }}{% if not group.rateHidden %} &middot; {{ group.totalRate|money(group.customer.currency) }}{% endif %}</span>
            </span>
            <button type="button" class="btn btn-sm btn-success abrechnung-bulk-toggle" data-ids="{{ group.ids|json_encode }}">
                {{ 'abrechnung.mark_customer'|trans }}
            </button>
        </div>
        {% for pid, proj in group.projects %}
        <div class="border-top">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
                <span>
                    {{ widgets.label_dot(proj.project.name, proj.project.color) }}
                    <span class="text-muted ms-2">{{ proj.totalDuration|duration }}{% if not proj.rateHidden %} &middot; {{ proj.totalRate|money(group.customer.currency) }}{% endif %}</span>
                </span>
                <button type="button" class="btn btn-sm btn-outline-success abrechnung-bulk-toggle" data-ids="{{ proj.ids|json_encode }}">
                    {{ 'abrechnung.mark_project'|trans }}
                </button>
            </div>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>{{ 'abrechnung.date'|trans }}</th>
                        <th>{{ 'abrechnung.description'|trans }}</th>
                        <th>{{ 'abrechnung.activity'|trans }}</th>
                        <th>{{ 'abrechnung.user'|trans }}</th>
                        <th class="text-end">{{ 'abrechnung.duration'|trans }}</th>
                        <th class="text-end">{{ 'abrechnung.amount'|trans }}</th>
                        <th style="width:160px;"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in proj.items %}
                    <tr id="row-{{ item.id }}">
                        <td>{{ item.begin|date_short }}</td>
                        <td>{{ item.description }}</td>
                        <td>{{ item.activity.name }}</td>
                        <td>{{ item.user.displayName }}</td>
                        <td class="text-end">{{ item.duration|duration }}</td>
                        <td class="text-end">{% if rate_visible[item.id] %}{{ item.rate|money(group.customer.currency) }}{% else %}&ndash;{% endif %}</td>
                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-sm btn-outline-success abrechnung-single-toggle"
                                    data-id="{{ item.id }}">
                                {{ 'abrechnung.mark_entry'|trans }}
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="card">
        <div class="card-body text-center text-muted py-4">{{ 'abrechnung.empty'|trans }}</div>
    </div>
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('kimai.initialized', function(event) {
        var kimai = event.detail.kimai;
        var undoLabel = '{{ 'abrechnung.undo'|trans|e('js') }}';
        var markLabel = '{{ 'abrechnung.mark_entry'|trans|e('js') }}';
        var errorTitle = '{{ 'abrechnung.error_title'|trans|e('js') }}';
        var errorRequest = '{{ 'abrechnung.error_request'|trans|e('js') }}';
        var errorSkipped = '{{ 'abrechnung.error_skipped'|trans|e('js') }}';
        var errorFailed = '{{ 'abrechnung.error_failed'|trans|e('js') }}';
        var markUrl = '{{ path("abrechnung_mark")|e('js') }}';
        var csrfToken = '{{ csrf_token(csrf_token_id)|e('js') }}';

        function isMarked(id) {
            var row = document.getElementById('row-' + id);
            return row !== null && row.classList.contains('text-decoration-line-through');
        }

        function applyRowState(id, exported) {
            var row = document.getElementById('row-' + id);
            if (!row) return;
            var btn = row.querySelector('.abrechnung-single-toggle');
            if (exported) {
                row.classList.add('text-decoration-line-through', 'text-muted');
                if (btn) { btn.classList.remove('btn-outline-success'); btn.classList.add('btn-outline-warning'); btn.textContent = undoLabel; }
            } else {
                row.classList.remove('text-decoration-line-through', 'text-muted');
                if (btn) { btn.classList.remove('btn-outline-warning'); btn.classList.add('btn-outline-success'); btn.textContent = markLabel; }
            }
        }

        function refreshBulkButtons() {
            document.querySelectorAll('.abrechnung-bulk-toggle').forEach(function(btn) {
                var ids = JSON.parse(btn.dataset.ids);
                var allExported = ids.length > 0 && ids.every(isMarked);
                btn.dataset.marked = allExported ? '1' : '0';
                btn.classList.remove('btn-success', 'btn-outline-success', 'btn-outline-warning');
                if (allExported) {
                    btn.classList.add('btn-outline-warning');
                    btn.textContent = undoLabel;
                } else {
                    btn.classList.add(btn.dataset.originalClass);
                    btn.textContent = btn.dataset.originalLabel;
                }
            });
        }

        function showError(message) {
            kimai.getPlugin('alert').error(errorTitle, message);
        }

        function sendState(ids, action, button) {
            var fd = new FormData();
            ids.forEach(function(id) { fd.append('timesheets[]', id); });
            fd.append('action', action);
            fd.append('_token', csrfToken);
            button.disabled = true;
            fetch(markUrl, {
                method: 'POST', body: fd, credentials: 'same-origin',
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            }).then(function(r) {
                if (!r.ok) { throw new Error('HTTP ' + r.status); }
                return r.json();
            }).then(function(data) {
                Object.keys(data.states || {}).forEach(function(k) {
                    applyRowState(parseInt(k, 10), data.states[k]);
                });
                refreshBulkButtons();
                var messages = [];
                if (data.skipped && data.skipped.length > 0) {
                    messages.push(errorSkipped.replace('%ids%', data.skipped.join(', ')));
                }
                if (data.failed && data.failed.length > 0) {
                    messages.push(errorFailed.replace('%ids%', data.failed.join(', ')));
                }
                if (messages.length > 0) {
                    showError(messages);
                }
            }).catch(function() {
                showError(errorRequest);
            }).finally(function() {
                button.disabled = false;
            });
        }

        document.querySelectorAll('.abrechnung-single-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var id = parseInt(this.dataset.id, 10);
                sendState([id], isMarked(id) ? 'unmark' : 'mark', this);
            });
        });

        document.querySelectorAll('.abrechnung-bulk-toggle').forEach(function(btn) {
            btn.dataset.originalLabel = btn.textContent.trim();
            btn.dataset.originalClass = btn.classList.contains('btn-success') ? 'btn-success' : 'btn-outline-success';
            btn.dataset.marked = '0';
            btn.addEventListener('click', function() {
                var ids = JSON.parse(this.dataset.ids);
                // all marked -> undo all; otherwise mark the rest (already marked ones stay marked)
                sendState(ids, this.dataset.marked === '1' ? 'unmark' : 'mark', this);
            });
        });
    });
    </script>
{% endblock %}
